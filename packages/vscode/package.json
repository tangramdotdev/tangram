{
	"name": "tangram",
	"displayName": "Tangram",
	"version": "0.0.0",
	"description": "Tangram extension for Visual Studio Code.",
	"categories": [
		"Formatters",
		"Linters",
		"Other",
		"Programming Languages"
	],
	"license": "MIT",
	"repository": {
		"url": "https://github.com/tangramdotdev/tangram"
	},
	"publisher": "tangramdotdev",
	"main": "./extension.js",
	"scripts": {
		"build": "esbuild --bundle --outfile=extension.js --format=cjs --sourcemap --platform=node --external:vscode extension.ts && vsce package --no-dependencies --no-update-package-json --no-git-tag-version",
		"check": "tsc && oxlint extension.ts",
		"format": "oxfmt --write extension.ts"
	},
	"dependencies": {
		"vscode-languageclient": "^11.0.0"
	},
	"devDependencies": {
		"@types/node": "^26.6.5",
		"@types/vscode": "^1.140.0",
		"@vscode/vsce": "^4.0.0"
	},
	"contributes": {
		"commands": [
			{
				"category": "Tangram",
				"command": "tangram.restartLanguageServer",
				"title": "Restart Language Server"
			}
		],
		"configuration": {
			"properties": {
				"tangram.enable": {
					"default": true,
					"description": "Enable the Tangram Language Server.",
					"scope": "window",
					"type": "boolean"
				},
				"tangram.command": {
					"default": [
						"tangram",
						"lsp"
					],
					"description": "The command and arguments to start the Tangram Language Server. Example: [\"tangram\", \"lsp\", \"--log-level\", \"debug\"]",
					"scope": "window",
					"type": "array",
					"items": {
						"type": "string"
					}
				}
			},
			"title": "Tangram"
		},
		"configurationDefaults": {
			"[tangram-interface-json]": {
				"editor.detectIndentation": false,
				"editor.insertSpaces": true,
				"editor.tabSize": 2
			},
			"[tangram-interface-python]": {
				"editor.detectIndentation": false,
				"editor.insertSpaces": true,
				"editor.tabSize": 4
			},
			"[tangram-interface-typescript]": {
				"editor.detectIndentation": false,
				"editor.insertSpaces": true,
				"editor.tabSize": 2
			},
			"[tangram-javascript]": {
				"editor.detectIndentation": false,
				"editor.insertSpaces": true,
				"editor.tabSize": 2
			},
			"[tangram-json]": {
				"editor.detectIndentation": false,
				"editor.insertSpaces": true,
				"editor.tabSize": 2
			},
			"[tangram-python]": {
				"editor.detectIndentation": false,
				"editor.insertSpaces": true,
				"editor.tabSize": 4
			},
			"[tangram-toml]": {
				"editor.detectIndentation": false,
				"editor.insertSpaces": true,
				"editor.tabSize": 2
			},
			"[tangram-typescript]": {
				"editor.detectIndentation": false,
				"editor.insertSpaces": true,
				"editor.tabSize": 2
			},
			"[tangram-yaml]": {
				"editor.detectIndentation": false,
				"editor.insertSpaces": true,
				"editor.tabSize": 2
			}
		},
		"grammars": [
			{
				"embeddedLanguages": {
					"source.js": "javascript"
				},
				"language": "tangram-javascript",
				"path": "./tangram-javascript.tmLanguage.json",
				"scopeName": "source.tg.js"
			},
			{
				"injectTo": [
					"source.tg.js"
				],
				"path": "./tangram-javascript-jsdoc-injection.tmLanguage.json",
				"scopeName": "documentation.injection.tg.js"
			},
			{
				"embeddedLanguages": {
					"source.python": "python"
				},
				"language": "tangram-python",
				"path": "./tangram-python.tmLanguage.json",
				"scopeName": "source.tg.py"
			},
			{
				"embeddedLanguages": {
					"source.ts": "typescript"
				},
				"language": "tangram-typescript",
				"path": "./tangram-typescript.tmLanguage.json",
				"scopeName": "source.tg.ts"
			},
			{
				"injectTo": [
					"source.tg.ts",
					"source.tgi.ts"
				],
				"path": "./tangram-typescript-jsdoc-injection.tmLanguage.json",
				"scopeName": "documentation.injection.tg.ts"
			},
			{
				"embeddedLanguages": {
					"source.json": "json"
				},
				"language": "tangram-json",
				"path": "./tangram-json.tmLanguage.json",
				"scopeName": "source.tg.json"
			},
			{
				"embeddedLanguages": {
					"source.toml": "toml"
				},
				"language": "tangram-toml",
				"path": "./tangram-toml.tmLanguage.json",
				"scopeName": "source.tg.toml"
			},
			{
				"embeddedLanguages": {
					"source.yaml": "yaml"
				},
				"language": "tangram-yaml",
				"path": "./tangram-yaml.tmLanguage.json",
				"scopeName": "source.tg.yaml"
			},
			{
				"embeddedLanguages": {
					"source.json": "json"
				},
				"language": "tangram-interface-json",
				"path": "./tangram-interface-json.tmLanguage.json",
				"scopeName": "source.tgi.json"
			},
			{
				"embeddedLanguages": {
					"source.python": "python"
				},
				"language": "tangram-interface-python",
				"path": "./tangram-interface-python.tmLanguage.json",
				"scopeName": "source.tgi.py"
			},
			{
				"embeddedLanguages": {
					"source.ts": "typescript"
				},
				"language": "tangram-interface-typescript",
				"path": "./tangram-interface-typescript.tmLanguage.json",
				"scopeName": "source.tgi.ts"
			}
		],
		"languages": [
			{
				"aliases": [
					"Tangram Interface JSON"
				],
				"configuration": "./tangram-json-language-configuration.json",
				"extensions": [
					".tgi.json"
				],
				"id": "tangram-interface-json"
			},
			{
				"aliases": [
					"Tangram Interface Python"
				],
				"configuration": "./tangram-python-language-configuration.json",
				"extensions": [
					".tgi.py"
				],
				"id": "tangram-interface-python"
			},
			{
				"aliases": [
					"Tangram Interface TypeScript"
				],
				"configuration": "./tangram-typescript-language-configuration.json",
				"extensions": [
					".tgi.ts"
				],
				"id": "tangram-interface-typescript"
			},
			{
				"aliases": [
					"Tangram JavaScript"
				],
				"configuration": "./tangram-javascript-language-configuration.json",
				"filenames": [
					"tangram.js"
				],
				"extensions": [
					".tg.js"
				],
				"id": "tangram-javascript"
			},
			{
				"aliases": [
					"Tangram JSON"
				],
				"configuration": "./tangram-json-language-configuration.json",
				"filenames": [
					"tangram.json"
				],
				"extensions": [
					".tg.json"
				],
				"id": "tangram-json"
			},
			{
				"aliases": [
					"Tangram Python"
				],
				"configuration": "./tangram-python-language-configuration.json",
				"filenames": [
					"tangram.py"
				],
				"extensions": [
					".tg.py"
				],
				"id": "tangram-python"
			},
			{
				"aliases": [
					"Tangram TOML"
				],
				"configuration": "./tangram-toml-language-configuration.json",
				"filenames": [
					"tangram.toml"
				],
				"extensions": [
					".tg.toml"
				],
				"id": "tangram-toml"
			},
			{
				"aliases": [
					"Tangram TypeScript"
				],
				"configuration": "./tangram-typescript-language-configuration.json",
				"filenames": [
					"tangram.ts"
				],
				"extensions": [
					".tg.ts"
				],
				"id": "tangram-typescript"
			},
			{
				"aliases": [
					"Tangram YAML"
				],
				"configuration": "./tangram-yaml-language-configuration.json",
				"filenames": [
					"tangram.yaml"
				],
				"extensions": [
					".tg.yaml"
				],
				"id": "tangram-yaml"
			}
		]
	},
	"icon": "tangram.png",
	"engines": {
		"vscode": "^1.92.0"
	}
}
