#!/bin/sh
set -eu

if [ "$1" = configure ]; then
	if ! getent group tangram >/dev/null; then
		addgroup --system tangram
	fi

	# Register a subordinate id range for the server's sandboxes after the ranges that are already registered.
	for file in /etc/subuid /etc/subgid; do
		touch "$file"
		if ! grep -q '^tangram:' "$file"; then
			start=100000
			while IFS=: read -r name first count || [ -n "$name" ]; do
				case "$first" in '' | *[!0-9]*) continue ;; esac
				case "$count" in '' | *[!0-9]*) continue ;; esac
				if [ $((first + count)) -gt "$start" ]; then
					start=$((first + count))
				fi
			done < "$file"
			if [ $((start + 65536)) -le 4294967295 ]; then
				if [ -s "$file" ] && [ -n "$(tail -c 1 "$file")" ]; then
					echo >> "$file"
				fi
				echo "tangram:$start:65536" >> "$file"
			fi
		fi
	done

	if [ -z "${2-}" ]; then
		deb-systemd-helper enable tangram.service >/dev/null
	fi
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload
		if [ -z "${2-}" ]; then
			deb-systemd-invoke start tangram.service
		elif systemctl --quiet is-active tangram.service; then
			deb-systemd-invoke restart tangram.service
		fi
	fi
fi
