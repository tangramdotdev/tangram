{
  "kind": "directory",
  "entries": {
    "hello.txt": {
      "kind": "file",
      "contents": "Hello, World!",
      "xattrs": {
        "user.tangram.token": "<token>"
      }
    },
    "link1": {
      "kind": "symlink",
      "path": "hello.txt"
    },
    "link2": {
      "kind": "symlink",
      "path": "hello.txt"
    }
  }
}