[Unit]
Description=Tangram server
After=network.target

[Service]
Type=notify
NotifyAccess=main
User=root
Group=tangram
UMask=0077
StateDirectory=tangram
StateDirectoryMode=0710
ExecStart=/usr/bin/tangram serve --config /etc/tangram/config.json --directory /var/lib/tangram --group-access --manager systemd
Delegate=yes
Restart=on-failure

[Install]
WantedBy=multi-user.target
